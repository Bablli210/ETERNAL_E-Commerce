# Shopify — the store the storefront reads from and checks out to.
# Without SHOPIFY_STOREFRONT_ACCESS_TOKEN the site runs on the committed
# catalogue snapshot (content/catalogue.snapshot.json) and checkout uses
# Shopify cart permalinks, which need no token.
SHOPIFY_STORE_DOMAIN=eternal-10199.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://eternal.example

# Measurement. Leave empty to load nothing.
# Use the same Meta Pixel and GA4 IDs that Shopify's Facebook & Instagram and
# Google channels use, so Purchase (fired on Shopify checkout) joins the
# PageView / ViewContent / AddToCart / InitiateCheckout events sent from here.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
