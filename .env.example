# Shopify — the store the storefront reads from and checks out to.
# Without SHOPIFY_STOREFRONT_ACCESS_TOKEN the site runs on the committed
# catalogue snapshot (content/catalogue.snapshot.json) and checkout uses
# Shopify cart permalinks, which need no token.
SHOPIFY_STORE_DOMAIN=eternal-10199.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://eternal.example

# Measurement. Leave empty to load nothing.
# Use the same Meta Pixel and GA4 IDs that Shopify's Facebook & Instagram and
# Google channels use, so Purchase (fired on Shopify checkout) joins the
# PageView / ViewContent / AddToCart / CheckoutClick events sent from here.
# CheckoutClick is a custom event (the bag's Checkout tap); Shopify's channel
# fires the standard InitiateCheckout and Purchase on checkout itself.
# /launch-checklist shows which of these keys are set (never their values).
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=

# Review builds only: show the art-direction brief inside empty image slots.
# Leave unset in production, where empty slots render as a quiet surface.
NEXT_PUBLIC_SHOW_PLACEHOLDERS=

# Meta Conversions API: server copies of ViewContent and AddToCart, deduplicated
# with the pixel by event id. Needs the pixel id above plus a CAPI access token
# (Events Manager > Settings > Conversions API). NEXT_PUBLIC_META_CAPI=1 turns
# the browser side on.
META_CAPI_TOKEN=
NEXT_PUBLIC_META_CAPI=
META_GRAPH_VERSION=v21.0

# Set to the root domain (e.g. .myeternal.net) once checkout runs on a
# subdomain, so the ad click cookies (_fbc, eternal_utm) reach checkout.
COOKIE_DOMAIN=

# The branded checkout host once checkout.{your-domain} is the store's primary
# domain in Shopify (host only, e.g. checkout.myeternal.net). Cart permalinks,
# the bag's preconnect, the policy links and the newsletter signup (/api/join
# posts to Shopify's customer form there) use it; falls back to the store domain.
SHOPIFY_CHECKOUT_DOMAIN=

# After the order (no variable to set). The storefront empties the bag when a
# page opens with ?ordered=1, then drops the flag from the address. Point the
# "Continue shopping" link on Shopify's thank-you / order status page at
# https://<NEXT_PUBLIC_SITE_URL>/?ordered=1, e.g. through the redirect that
# sends visitors of the Shopify-hosted domain on to the storefront. Without it,
# a buyer who comes back still sees the bottles they just paid for.
